<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,user-scalable=no">
<title>물품관리</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,sans-serif;background:#f5f5f5}
.header{background:linear-gradient(135deg,#00b894,#00cec9);color:#fff;padding:12px 15px;display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;z-index:100;box-shadow:0 2px 8px rgba(0,0,0,.2)}
.header-title{font-weight:bold;font-size:15px}
.header-right{display:flex;gap:6px}
.hbtn{padding:5px 10px;border:none;border-radius:5px;cursor:pointer;font-size:12px;font-weight:bold}
.tabs{display:flex;overflow-x:auto;gap:4px;padding:8px;background:#fff;border-bottom:1px solid #eee}
.tab{flex-shrink:0;padding:8px 14px;background:#f0f0f0;border:none;border-radius:20px;cursor:pointer;font-size:13px;font-weight:bold;color:#666}
.tab.active{background:#00b894;color:#fff}
.container{padding:10px}
.card{background:#fff;border-radius:10px;padding:15px;margin-bottom:10px;box-shadow:0 2px 6px rgba(0,0,0,.08)}
.card-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
.card-title{font-weight:bold;font-size:15px;color:#2d3436}
.qty-badge{background:#00b894;color:#fff;padding:4px 12px;border-radius:20px;font-weight:bold;font-size:14px}
.qty-badge.zero{background:#b2bec3}
.qty-badge.low{background:#e17055}
.item-row{display:flex;align-items:center;padding:10px 0;border-bottom:1px solid #f5f5f5}
.item-row:last-child{border-bottom:none}
.item-check{width:22px;height:22px;margin-right:10px;cursor:pointer;flex-shrink:0}
.item-info{flex:1}
.item-name{font-size:14px;font-weight:bold;color:#2d3436}
.item-unit{font-size:12px;color:#b2bec3;margin-top:2px}
.item-qty{font-size:16px;font-weight:bold;text-align:right;min-width:60px}
.item-qty.positive{color:#00b894}
.item-qty.zero{color:#b2bec3}
.item-qty.negative{color:#e17055}
.action-bar{position:fixed;bottom:0;left:0;right:0;background:#fff;padding:12px;border-top:2px solid #eee;display:flex;gap:8px;z-index:100}
.action-bar.hidden{display:none}
.abtn{flex:1;padding:14px;border:none;border-radius:10px;font-size:14px;font-weight:bold;cursor:pointer;color:#fff}
.abtn.in{background:#0984e3}
.abtn.out{background:#e17055}
.abtn.ret{background:#6c5ce7}
.modal-bg{display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.5);z-index:200}
.modal-bg.show{display:flex;align-items:flex-end}
.modal{background:#fff;border-radius:16px 16px 0 0;padding:20px;width:100%;max-height:85vh;overflow-y:auto}
.modal-title{font-size:17px;font-weight:bold;margin-bottom:15px;color:#2d3436}
.modal-close{float:right;font-size:24px;cursor:pointer;color:#b2bec3;margin-top:-4px}
.selected-list{background:#f5f5f5;border-radius:8px;padding:10px;margin-bottom:15px;max-height:200px;overflow-y:auto}
.sel-item{display:flex;justify-content:space-between;align-items:center;padding:8px;background:#fff;border-radius:6px;margin-bottom:6px}
.sel-item-name{font-size:14px;font-weight:bold}
.qty-input-wrap{display:flex;align-items:center;gap:8px;margin-top:8px}
.qty-input-wrap label{font-size:14px;font-weight:bold;min-width:70px}
.qty-input{width:80px;padding:8px;border:2px solid #ddd;border-radius:8px;font-size:16px;text-align:center}
.team-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-top:10px}
.team-btn{padding:14px;border:2px solid #ddd;border-radius:10px;background:#fff;cursor:pointer;font-size:14px;font-weight:bold;color:#2d3436}
.team-btn.selected{background:#00b894;color:#fff;border-color:#00b894}
.confirm-btn{width:100%;padding:15px;background:#00b894;color:#fff;border:none;border-radius:10px;font-size:16px;font-weight:bold;cursor:pointer;margin-top:15px}
.confirm-btn:disabled{background:#b2bec3}
.loading-overlay{display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.6);z-index:999;align-items:center;justify-content:center;color:#fff;font-size:18px;font-weight:bold}
.loading-overlay.show{display:flex}
.login-wrap{display:flex;align-items:center;justify-content:center;min-height:100vh;background:linear-gradient(135deg,#00b894,#00cec9)}
.login-box{background:#fff;border-radius:16px;padding:30px;width:90%;max-width:360px;box-shadow:0 10px 30px rgba(0,0,0,.2)}
.login-title{text-align:center;font-size:22px;font-weight:bold;color:#00b894;margin-bottom:8px}
.login-sub{text-align:center;color:#b2bec3;font-size:13px;margin-bottom:25px}
.login-input{width:100%;padding:13px;border:2px solid #eee;border-radius:10px;font-size:15px;margin-bottom:12px;outline:none}
.login-input:focus{border-color:#00b894}
.login-btn{width:100%;padding:15px;background:#00b894;color:#fff;border:none;border-radius:10px;font-size:16px;font-weight:bold;cursor:pointer}
.team-select-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:15px}
.team-sel-btn{padding:12px;border:2px solid #eee;border-radius:10px;background:#fff;cursor:pointer;font-size:13px;font-weight:bold;color:#2d3436;text-align:center}
.team-sel-btn.active{border-color:#00b894;background:#00b894;color:#fff}
.tx-row{padding:10px;border-bottom:1px solid #f5f5f5;font-size:13px}
.tx-type{display:inline-block;padding:2px 8px;border-radius:10px;font-size:11px;font-weight:bold;margin-right:6px}
.tx-type.입고{background:#d5f5e3;color:#00b894}
.tx-type.출고{background:#fde8e8;color:#e17055}
.tx-type.반납{background:#e8e4ff;color:#6c5ce7}
.search-bar{padding:8px;background:#fff;border-bottom:1px solid #eee}
.search-bar input{width:100%;padding:10px;border:1px solid #eee;border-radius:8px;font-size:14px}
.empty{text-align:center;padding:40px;color:#b2bec3;font-size:14px}
</style>
</head>
<body>

<div class="loading-overlay" id="loading">⏳ 처리 중...</div>

<!-- 로그인 화면 -->
<div id="loginScreen">
<div class="login-wrap">
<div class="login-box">
  <div class="login-title">📦 물품관리</div>
  <div class="login-sub">이름과 팀을 선택하세요</div>
  <input class="login-input" id="loginName" placeholder="이름">
  <div style="font-weight:bold;font-size:13px;margin-bottom:8px;color:#636e72">팀 선택</div>
  <div class="team-select-grid" id="teamSelectGrid"></div>
  <button class="login-btn" onclick="doLogin()">시작하기</button>
</div>
</div>
</div>

<!-- 메인 앱 -->
<div id="mainApp" style="display:none">
  <div class="header">
    <span class="header-title" id="headerTitle">물품관리</span>
    <div class="header-right">
      <button class="hbtn" style="background:#fff;color:#00b894" onclick="loadData(true)">🔄</button>
      <button class="hbtn" style="background:rgba(255,255,255,.3);color:#fff" onclick="doLogout()">로그아웃</button>
    </div>
  </div>

  <div class="tabs" id="tabBar"></div>
  <div class="search-bar"><input type="text" id="searchInput" placeholder="물품 검색..." oninput="renderItems()"></div>

  <div class="container" id="itemList"></div>

  <div class="action-bar hidden" id="actionBar">
    <button class="abtn in" id="btnIn" onclick="openModal('in')" style="display:none">📥 입고</button>
    <button class="abtn out" id="btnOut" onclick="openModal('out')">📤 출고</button>
    <button class="abtn ret" id="btnRet" onclick="openModal('ret')" style="display:none">🔄 반납</button>
  </div>
</div>

<!-- 모달 -->
<div class="modal-bg" id="modalBg" onclick="if(event.target===this)closeModal()">
<div class="modal" id="modalContent"></div>
</div>

<script>
const INVENTORY_API = 'https://script.google.com/macros/s/AKfycbw6J-NIAmA8TiWxGgrGsuHWhA0qeka4cAujK6x0Mwu_QFJ-a3YhP6JPkzRx3UR5f2G8/exec';
const TEAMS = ['화성','수원','평택','2팀','3팀','4팀','5팀','6팀'];
const WAREHOUSE = '창고';
const ALL_TABS = [WAREHOUSE, ...TEAMS, '거래내역'];

let currentUser = null;
let currentTab = WAREHOUSE;
let allItems = [];      // 창고 아이템
let teamStocks = {};    // 팀별 재고
let transactions = [];  // 거래내역
let selected = new Map(); // 선택된 아이템

// ── 로그인 ──────────────────────────────
function initLogin() {
  const grid = document.getElementById('teamSelectGrid');
  grid.innerHTML = ALL_TABS.filter(t => t !== '거래내역').map(t =>
    `<button class="team-sel-btn" onclick="selectTeam(this,'${t}')">${t === WAREHOUSE ? '🏭 창고' : t}</button>`
  ).join('');

  const saved = localStorage.getItem('invUser');
  if (saved) {
    currentUser = JSON.parse(saved);
    startApp();
  }
}

function selectTeam(el, team) {
  document.querySelectorAll('.team-sel-btn').forEach(b => b.classList.remove('active'));
  el.classList.add('active');
  el.dataset.team = team;
}

function doLogin() {
  const name = document.getElementById('loginName').value.trim();
  const teamBtn = document.querySelector('.team-sel-btn.active');
  if (!name) { alert('이름을 입력하세요'); return; }
  if (!teamBtn) { alert('팀을 선택하세요'); return; }
  currentUser = { name, team: teamBtn.dataset.team };
  localStorage.setItem('invUser', JSON.stringify(currentUser));
  startApp();
}

function doLogout() {
  if (!confirm('로그아웃 하시겠습니까?')) return;
  localStorage.removeItem('invUser');
  currentUser = null;
  selected.clear();
  document.getElementById('mainApp').style.display = 'none';
  document.getElementById('loginScreen').style.display = 'block';
}

function startApp() {
  document.getElementById('loginScreen').style.display = 'none';
  document.getElementById('mainApp').style.display = 'block';
  document.getElementById('headerTitle').textContent = `📦 물품관리 (${currentUser.name} - ${currentUser.team})`;
  buildTabs();
  loadData(false);
}

// ── 탭 ──────────────────────────────────
function buildTabs() {
  const bar = document.getElementById('tabBar');
  bar.innerHTML = ALL_TABS.map(t =>
    `<button class="tab${t === currentTab ? ' active' : ''}" onclick="switchTab('${t}')">${t === WAREHOUSE ? '🏭 창고' : t === '거래내역' ? '📋 거래내역' : t}</button>`
  ).join('');
}

function switchTab(tab) {
  currentTab = tab;
  selected.clear();
  buildTabs();
  renderItems();
  updateActionBar();
}

// ── 데이터 로드 ──────────────────────────
async function loadData(force) {
  if (!force) {
    const cache = localStorage.getItem('invCache');
    if (cache) {
      const p = JSON.parse(cache);
      if (Date.now() - p.time < 300000) {
        allItems = p.allItems;
        teamStocks = p.teamStocks;
        transactions = p.transactions;
        renderItems();
        return;
      }
    }
  }
  showLoading(true);
  try {
    const res = await fetch(INVENTORY_API + '?action=getInventory&t=' + Date.now());
    const data = await res.json();
    allItems = data.items || [];
    teamStocks = data.teamStocks || {};
    transactions = data.transactions || [];
    localStorage.setItem('invCache', JSON.stringify({ allItems, teamStocks, transactions, time: Date.now() }));
    renderItems();
  } catch(e) {
    alert('로딩 실패: ' + e.message);
  } finally {
    showLoading(false);
  }
}

// ── 아이템 렌더링 ────────────────────────
function renderItems() {
  const query = (document.getElementById('searchInput').value || '').trim().toLowerCase();
  const el = document.getElementById('itemList');

  if (currentTab === '거래내역') {
    renderTransactions(el, query);
    return;
  }

  let items = [];
  if (currentTab === WAREHOUSE) {
    items = allItems.map(i => ({ name: i.name, unit: i.unit, qty: i.quantity }));
  } else {
    const stock = teamStocks[currentTab] || {};
    // 해당 팀이 보유한 아이템만 (수량 > 0)
    const all = allItems.map(i => ({ name: i.name, unit: i.unit, qty: stock[i.name] || 0 }));
    items = all.filter(i => i.qty > 0);
  }

  if (query) items = items.filter(i => i.name.toLowerCase().includes(query));

  if (items.length === 0) {
    el.innerHTML = '<div class="empty">물품이 없습니다</div>';
    updateActionBar();
    return;
  }

  el.innerHTML = items.map(i => {
    const isChecked = selected.has(i.name);
    const qtyClass = i.qty > 0 ? 'positive' : i.qty < 0 ? 'negative' : 'zero';
    return `
    <div class="card">
      <div class="item-row">
        <input type="checkbox" class="item-check" data-name="${i.name}" data-unit="${i.unit}" onchange="toggleSelect(this)" ${isChecked ? 'checked' : ''}>
        <div class="item-info">
          <div class="item-name">${i.name}</div>
          <div class="item-unit">${i.unit}</div>
        </div>
        <div class="item-qty ${qtyClass}">${i.qty}</div>
      </div>
    </div>`;
  }).join('');

  updateActionBar();
}

function renderTransactions(el, query) {
  let txs = [...transactions];
  if (query) txs = txs.filter(t => t.item && t.item.toLowerCase().includes(query));
  if (txs.length === 0) { el.innerHTML = '<div class="empty">거래내역이 없습니다</div>'; return; }
  el.innerHTML = txs.map(t => `
    <div class="tx-row">
      <span class="tx-type ${t.type}">${t.type}</span>
      <strong>${t.item}</strong> ${t.qty}개
      <span style="color:#b2bec3"> · ${t.from}→${t.to} · ${t.user}</span>
      <div style="color:#b2bec3;font-size:11px;margin-top:3px">${t.date}</div>
    </div>`).join('');
}

// ── 선택 ────────────────────────────────
function toggleSelect(cb) {
  const name = cb.dataset.name;
  const unit = cb.dataset.unit;
  if (cb.checked) selected.set(name, { name, unit, qty: 1 });
  else selected.delete(name);
  updateActionBar();
}

function updateActionBar() {
  const bar = document.getElementById('actionBar');
  const btnIn  = document.getElementById('btnIn');
  const btnOut = document.getElementById('btnOut');
  const btnRet = document.getElementById('btnRet');

  if (selected.size === 0 || currentTab === '거래내역') {
    bar.classList.add('hidden'); return;
  }
  bar.classList.remove('hidden');

  if (currentTab === WAREHOUSE) {
    btnIn.style.display  = 'block';
    btnOut.style.display = 'block';
    btnRet.style.display = 'none';
  } else {
    btnIn.style.display  = 'none';
    btnOut.style.display = 'none';
    btnRet.style.display = 'block';
  }
}

// ── 모달 ────────────────────────────────
function openModal(type) {
  const items = Array.from(selected.values());
  if (items.length === 0) return;

  let html = '';

  if (type === 'in') {
    html = buildQtyModal('📥 입고', items, '창고에 추가됩니다', null, 'confirmIn');
  } else if (type === 'out') {
    html = buildQtyModal('📤 출고', items, '어느 팀으로 출고할까요?', TEAMS, 'confirmOut');
  } else if (type === 'ret') {
    html = buildQtyModal('🔄 반납', items, `${currentTab} → 창고로 반납`, null, 'confirmRet');
  }

  document.getElementById('modalContent').innerHTML = html;
  document.getElementById('modalBg').classList.add('show');
}

function buildQtyModal(title, items, desc, teamList, confirmFn) {
  const itemRows = items.map(i => `
    <div class="sel-item">
      <span class="sel-item-name">${i.name} (${i.unit})</span>
      <div class="qty-input-wrap">
        <label>수량</label>
        <input type="number" class="qty-input" id="qty_${i.name.replace(/\s/g,'_')}" value="1" min="1">
      </div>
    </div>`).join('');

  const teamSection = teamList ? `
    <div style="font-weight:bold;margin-bottom:8px">목적지 팀</div>
    <div class="team-grid" id="teamGrid">
      ${teamList.map(t => `<button class="team-btn" onclick="selectModalTeam(this,'${t}')">${t}</button>`).join('')}
    </div>` : '';

  return `
    <span class="modal-close" onclick="closeModal()">×</span>
    <div class="modal-title">${title}</div>
    <div style="color:#636e72;font-size:13px;margin-bottom:12px">${desc}</div>
    <div class="selected-list">${itemRows}</div>
    ${teamSection}
    <button class="confirm-btn" onclick="${confirmFn}()">확인</button>`;
}

function selectModalTeam(btn, team) {
  document.querySelectorAll('#teamGrid .team-btn').forEach(b => b.classList.remove('selected'));
  btn.classList.add('selected');
}

function getModalItems() {
  return Array.from(selected.values()).map(i => {
    const inputId = 'qty_' + i.name.replace(/\s/g, '_');
    const input = document.getElementById(inputId);
    return { name: i.name, unit: i.unit, qty: Number(input ? input.value : 1) };
  });
}

async function confirmIn() {
  const items = getModalItems();
  closeModal();
  showLoading(true);
  try {
    const res = await fetch(INVENTORY_API, { method: 'POST', body: JSON.stringify({ action: 'warehouseIn', items, user: currentUser.name }) });
    const r = await res.json();
    if (r.success) { selected.clear(); await loadData(true); alert('입고 완료!'); }
    else alert('오류: ' + r.error);
  } catch(e) { alert('실패: ' + e.message); }
  finally { showLoading(false); }
}

async function confirmOut() {
  const items = getModalItems();
  const teamBtn = document.querySelector('#teamGrid .team-btn.selected');
  if (!teamBtn) { alert('팀을 선택하세요'); return; }
  const team = teamBtn.textContent;
  closeModal();
  showLoading(true);
  try {
    const res = await fetch(INVENTORY_API, { method: 'POST', body: JSON.stringify({ action: 'warehouseOut', items, team, user: currentUser.name }) });
    const r = await res.json();
    if (r.success) { selected.clear(); await loadData(true); alert(`${team}으로 출고 완료!`); }
    else alert('오류: ' + r.error);
  } catch(e) { alert('실패: ' + e.message); }
  finally { showLoading(false); }
}

async function confirmRet() {
  const items = getModalItems();
  closeModal();
  showLoading(true);
  try {
    const res = await fetch(INVENTORY_API, { method: 'POST', body: JSON.stringify({ action: 'teamReturn', items, team: currentTab, user: currentUser.name }) });
    const r = await res.json();
    if (r.success) { selected.clear(); await loadData(true); alert('반납 완료!'); }
    else alert('오류: ' + r.error);
  } catch(e) { alert('실패: ' + e.message); }
  finally { showLoading(false); }
}

function closeModal() { document.getElementById('modalBg').classList.remove('show'); }
function showLoading(s) { document.getElementById('loading').classList.toggle('show', s); }

// ── 초기화 ───────────────────────────────
initLogin();
</script>
</body>
</html>
